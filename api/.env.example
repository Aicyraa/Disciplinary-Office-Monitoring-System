# Fake examples only. Replace with your existing Neon database URLs in ignored api/.env.
# Runtime adapter uses the pooled endpoint; Prisma CLI uses the direct endpoint.
# Supply these variables externally; application and Prisma scripts do not auto-load .env.
DATABASE_URL="postgresql://example_user:example_password@ep-example-pooler.us-east-2.aws.neon.tech/example_db?sslmode=require"
DIRECT_URL="postgresql://example_user:example_password@ep-example.us-east-2.aws.neon.tech/example_db?sslmode=require"
