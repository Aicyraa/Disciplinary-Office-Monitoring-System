{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "dist/api/src/server.js",
  "scripts": {
    "test": "npm --prefix .. test -- api/tests",
    "lint": "npm --prefix .. run lint --",
    "typecheck": "tsc --noEmit",
    "build": "npm run prisma:generate && tsc",
    "dev": "tsx --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/api/src/server.js",
    "prisma:validate": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js validate --config prisma.config.ts",
    "prisma:generate": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js generate --config prisma.config.ts",
    "prisma:smoke": "tsx --env-file-if-exists=../.env scripts/prisma-smoke.ts",
    "prisma:pull": "node --env-file-if-exists=../.env node_modules/prisma/build/index.js db pull --config prisma.config.ts",
    "prisma:migrate": "node --env-file=../.env ./node_modules/.bin/prisma migrate dev --name prod",
    "prisma:deploy": "node --env-file=../.env ./node_modules/.bin/prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/functions": "3.9.11",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "dotenv-cli": "^11.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
