{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git merge *)",
      "Bash(npm ci)",
      "Bash(npm --prefix api ci)",
      "Bash(npm --prefix client ci)",
      "Bash(npm --prefix api run prisma:generate)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run lint)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build)",
      "Bash(npm run build *)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npm --prefix api test *)",
      "Bash(npm --prefix client test *)",
      "Bash(npm --prefix api run lint)",
      "Bash(npm --prefix api run typecheck)",
      "Bash(npm --prefix api run build)",
      "Bash(npm --prefix client run lint)",
      "Bash(npm --prefix client run typecheck)",
      "Bash(npm --prefix client run build)",
      "Bash(npm --prefix client run dev)",
      "Agent(scout)",
      "Agent(reviewer)",
      "mcp__serena__find_symbol",
      "mcp__serena__find_declaration",
      "mcp__serena__find_implementations",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__get_diagnostics_for_file",
      "mcp__serena__search_for_pattern",
      "mcp__serena__find_file",
      "mcp__serena__list_dir",
      "mcp__serena__read_file",
      "mcp__serena__list_memories",
      "mcp__serena__read_memory",
      "mcp__serena__replace_symbol_body",
      "mcp__serena__insert_after_symbol",
      "mcp__serena__insert_before_symbol",
      "mcp__serena__rename_symbol",
      "mcp__serena__safe_delete_symbol",
      "mcp__context7__*",
      "mcp__playwright__*"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git clean*)",
      "Bash(git checkout*)",
      "Bash(git branch -D*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree add*)",
      "Bash(sudo*)",
      "Bash(rm -rf*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "WebFetch",
      "WebSearch",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "mcp__serena__create_text_file",
      "mcp__serena__replace_content",
      "mcp__serena__replace_in_files",
      "mcp__serena__execute_shell_command",
      "mcp__serena__write_memory",
      "mcp__serena__edit_memory",
      "mcp__serena__delete_memory",
      "mcp__serena__rename_memory",
      "mcp__serena__activate_project",
      "mcp__serena__remove_project",
      "mcp__serena__onboarding",
      "mcp__serena__serena_repl",
      "mcp__serena__jet_brains_*",
      "mcp__serena__delete_lines",
      "mcp__serena__insert_at_line",
      "mcp__serena__replace_lines"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|NotebookEdit|Bash|mcp__serena__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/role-guard.mjs\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
