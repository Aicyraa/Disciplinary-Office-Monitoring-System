# Fake examples only. Copy to ignored .env at the repo root; api/ and client/ both read it.
# Never commit real values.

# ORIGINS: one pair, localhost, in development and in the local production build.
#   app  http://localhost:<CLIENT_PORT>   (`npm run dev` and `npm start` both serve it; open it at "localhost",
#                                          127.0.0.1 is a different origin and is refused)
#   API  http://localhost:<SERVER_PORT>   (accepts exactly the app origin above)
# Only a real deployment sets APP_BASE_URL (below) and VITE_API_URL.

# CLIENT (Vite dev server and preview port; only VITE_-prefixed keys are exposed to browser code)
CLIENT_PORT=5173
# Where the browser finds the API (VITE_ keys are public; never put secrets here). Leave unset locally: the
# client then calls http://localhost:<SERVER_PORT>. Set it only when the API is on another host (deployment).
# VITE_API_URL="https://api.example.edu"

# BACKEND
SERVER_PORT=3000

# DB (Neon): DATABASE_URL is pooled (runtime adapter), DATABASE_URL_UNPOOLED is direct (Prisma CLI)
DATABASE_URL="postgresql://example_user:example_password@ep-example-pooler.us-east-2.aws.neon.tech/example_db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://example_user:example_password@ep-example.us-east-2.aws.neon.tech/example_db?sslmode=require"

# SESSIONS
SESSION_SECRET="example-session-secret-change-me-32-chars-min"

# POWER AUTOMATE: the signed trigger URL IS the secret (no shared key exists). Server-side only, never VITE_.
# See docs/sdao-handoff/POWER-AUTOMATE.md
PA_NOTIFY_URL="https://example.invalid/powerautomate/notify"
# Key the Power Automate term set-up sends in the X-SDO-Job-Key header (POST /internal/clearances/term-setup).
# At least 32 characters (for example `openssl rand -hex 32`); shorter or unset turns the route off (503).
PA_JOB_KEY="example-job-secret-change-me-32-chars-min"
# PA_GATE_URL is no longer used: gate reports go through the one notify flow above (decision 19).
# Behind a reverse proxy set TRUST_PROXY to the number of proxies (usually 1) so the public gate form
# rate limit sees the visitor, not the proxy. Leave unset on a laptop.
# TRUST_PROXY=1
# Staff alerts have no dedicated mailbox: they are emailed to every ACTIVE employee account (employee_email).
# The sender is the flow owner's own account. Leave PA_NOTIFY_URL unset locally: emails are then skipped and the
# in-app inbox still works.
# Public base URL of the client: the one browser origin the API accepts, and the base of links inside emails
APP_BASE_URL="http://localhost:5173"

# NEON OBJECT STORAGE (S3-compatible, private bucket)
AWS_ACCESS_KEY_ID="EXAMPLEACCESSKEYID"
AWS_SECRET_ACCESS_KEY="example-secret-access-key"
AWS_ENDPOINT_URL_S3="https://example.invalid"
AWS_REGION="us-east-2"
# Bucket for the proof files students upload. Must already exist in Neon: the API never creates buckets.
# Older spellings BUCKET_STORAGE_FILES, BUCKET_STORAGE and STORAGE_BUCKET are still read.
STORAGE_BUCKET_FILES='assets-files'
# Bucket for the sanction template files staff upload (Handbook > Sanction templates). Must exist in Neon too; it never falls back to the files bucket.
STORAGE_BUCKET_TEMPLATES='assets-sanction-templates'

